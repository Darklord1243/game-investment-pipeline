# Steam Web API key (IStoreService/GetAppList — required since Valve
# removed ISteamApps/GetAppList/v2)
# Get this from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Twitch API Credentials
# Get these from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 Key
# Get this from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Reddit API Credentials
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=

# Flask Session Secret Key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# SQLite database (default used when unset)
# DATABASE_URL=sqlite:///data/game_metrics.db

# AWS credentials for weekly CI artifact upload (S3)
# Used by .github/workflows/weekly_pipeline.yml
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
